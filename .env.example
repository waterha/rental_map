# Go reads process environment variables. Use scripts/start.ps1 for local startup.
ADDR=127.0.0.1:8080
# Leave empty to use data/rental.db. PostgreSQL is the production database.
DATABASE_URL=
DATA_DIR=data
STATIC_DIR=dist
# Local publishing is disabled when bound publicly unless explicitly enabled.
ALLOW_PUBLISH=true

# Frontend: copy these two fields into .env.local and fill your AMap Web JS API credentials.
# Vite reads .env.local at development startup / build time.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# Backend only: configure these in .env.server.local, NEVER prefix with VITE_.
SMTP_FROM=
SMTP_AUTH_CODE=
AUTH_ALLOWED_EMAIL_DOMAINS=qq.com,163.com,126.com,gmail.com,outlook.com,hotmail.com,icloud.com
# Enable for HTTPS deployments. Local HTTP development uses false.
AUTH_COOKIE_SECURE=false

# Public deployment (backend only). Exact HTTPS domain; never a path.
APP_ENV=development
PUBLIC_ORIGIN=
# Baota Nginx on the SAME host. Never trust 0.0.0.0/0 or ::/0.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=60
MAX_CONCURRENT_REQUESTS=64
MAX_CONCURRENT_AUTH=4
MAX_CONCURRENT_UPLOADS=2
UPLOAD_STORAGE_MB=1024
# Compose uses separate administrator and restricted application passwords.
POSTGRES_PASSWORD=
RENTAL_DB_PASSWORD=
